#. Plugin Name of the plugin
#: acf-svg-icon-picker.php
msgid "Advanced Custom Fields: SVG Icon Picker"
msgstr "Geavanceerde aangepaste velden: SVG-iconpicker"

#. Plugin URI of the plugin
#: acf-svg-icon-picker.php
msgid "https://github.com/smithfield-studio/acf-svg-icon-picker"
msgstr "https://github.com/smithfield-studio/acf-svg-icon-picker"

#. Description of the plugin
#: acf-svg-icon-picker.php
msgid "Allows you to pick an icon from a predefined list"
msgstr "Hiermee kunt u een icoon uit een vooraf gedefinieerde lijst kiezen"

#. Author of the plugin
#: acf-svg-icon-picker.php
msgid "Smithfield & Studio Lemon"
msgstr "Smithfield & Studio Lemon"

#. Author URI of the plugin
#: acf-svg-icon-picker.php
msgid "https://github.com/smithfield-studio/acf-svg-icon-picker/"
msgstr "https://github.com/smithfield-studio/acf-svg-icon-picker/"

#. translators: %s: the saved icon value, e.g. "nucleo.fan".
#: resources/views/acf-field.php:26
#, php-format
msgid "Missing icon: %s"
msgstr "Ontbrekend icoon: %s"

#: resources/views/acf-field.php:30 src/ACF_Field_Svg_Icon_Picker.php:496
msgid "Choose icon"
msgstr "Kies icoon"

#: resources/views/acf-field.php:35
msgid "Clear"
msgstr "Wissen"

#: resources/views/acf-field.php:88
msgid "Icon not found."
msgstr "Icoon niet gevonden."

#. translators: %s: the missing icon's path in its set, e.g. "nucleo/fan.svg", or the saved value when it is not a valid icon name.
#: resources/views/acf-field.php:94
#, php-format
msgid "Please replace or check path: %s"
msgstr "Vervang of controleer het pad: %s"

#: src/ACF_Field_Svg_Icon_Picker.php:59
msgid "SVG Icon Picker"
msgstr "SVG Icon Picker"

#: src/ACF_Field_Svg_Icon_Picker.php:65
msgid "Error!"
msgstr "Fout!"

#: src/ACF_Field_Svg_Icon_Picker.php:119
msgid ""
"The acf_svg_icon_picker_custom_location filter should return an array with "
"path and url, or a list of such arrays."
msgstr ""
"Het filter `acf_svg_icon_picker_custom_location` moet een array met pad en "
"url retourneren, of een lijst met dergelijke arrays."

#: src/ACF_Field_Svg_Icon_Picker.php:313
msgid "Return Format"
msgstr "Return formaat"

#: src/ACF_Field_Svg_Icon_Picker.php:319
msgid "Value"
msgstr "Waarde"

#: src/ACF_Field_Svg_Icon_Picker.php:320
msgid "Icon"
msgstr "Icoon"

#: src/ACF_Field_Svg_Icon_Picker.php:321
msgid "Array"
msgstr "Array"

#: src/ACF_Field_Svg_Icon_Picker.php:333
msgid "Allowed Groups"
msgstr "Toegestane ​​Groepen"

#: src/ACF_Field_Svg_Icon_Picker.php:334
msgid ""
"Limit the picker to these groups for this field. Leave empty to show all."
msgstr ""
"Beperk de selectielijst voor dit veld tot deze groepen. Laat het veld leeg "
"om alles weer te geven."

#: src/ACF_Field_Svg_Icon_Picker.php:470
msgid ""
"No icons found. Check the paths returned by your "
"<code>acf_svg_icon_picker_custom_location</code> filter."
msgstr ""
"Er zijn geen pictogrammen gevonden. Controleer de paden die worden "
"geretourneerd door je filter ` <code>acf_svg_icon_picker_custom_location</"
"code> `."

#. translators: %s: theme folder path (default 'icons/')
#: src/ACF_Field_Svg_Icon_Picker.php:476
#, php-format
msgid ""
"To add icons, add your SVG files in the <code>/%s</code> folder in your "
"theme."
msgstr ""
"Om pictogrammen toe te voegen, plaats je je SVG-bestanden in de map <code>/"
"%s</code> van je thema."

#: src/ACF_Field_Svg_Icon_Picker.php:494
msgid "No icons match your filter."
msgstr ""

#: src/ACF_Field_Svg_Icon_Picker.php:531
msgid "Close"
msgstr "Sluiten"

#: src/ACF_Field_Svg_Icon_Picker.php:535
msgid "Select an icon"
msgstr "Kies een icoon"

#: src/ACF_Field_Svg_Icon_Picker.php:537 src/ACF_Field_Svg_Icon_Picker.php:543
msgid "Start typing to filter icons"
msgstr "Begin met typen om iconen te filteren"

#: src/graphql.php:32
msgid "An SVG icon picked from the configured icon set."
msgstr "Een SVG-icoon uit de geconfigureerde iconenset."

#: src/graphql.php:36
msgid ""
"The saved slug. Bare slug in flat mode, \"groupkey.slug\" in grouped mode."
msgstr ""
"De opgeslagen slug. De slug zelf in de platte modus, \"groupkey.slug\" in de "
"gegroepeerde modus."

#: src/graphql.php:43
msgid "Public URL of the resolved SVG file."
msgstr "Openbare URL van het verwerkte SVG-bestand."

#: src/graphql.php:47
msgid "Inline SVG markup for the resolved icon."
msgstr "Inline SVG-code voor het weergegeven icoon."
